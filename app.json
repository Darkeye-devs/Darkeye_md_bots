{
  "name": "Dark Eyes Bot",
  "description": "WhatsApp MD bot — 248 commands that actually run, with a browser pairing panel.",
  "repository": "https://github.com/Darkeye-devs/Darkeye_md_bots",
  "logo": "https://raw.githubusercontent.com/Darkeye-devs/Darkeye_md_bots/main/src/web/public/assets/logo.svg",
  "keywords": ["whatsapp", "bot", "baileys", "md"],
  "env": {
    "SESSION_ID": {
      "description": "Session ID from the pairing panel (DarkEyes~...). Required.",
      "required": true
    },
    "OWNER_NUMBER": {
      "description": "Your WhatsApp number, country code first, digits only. Required.",
      "required": true
    },
    "BOT_NAME": { "value": "Dark Eyes", "required": false },
    "PREFIX": { "value": ".", "required": false },
    "BOT_MODE": { "value": "public", "required": false },
    "TZ": { "value": "Africa/Lagos", "required": false },
    "NODE_ENV": { "value": "production", "required": false },
    "PANEL_TOKEN": {
      "description": "Locks the pairing panel. Leave empty to keep it open.",
      "required": false
    },
    "AI_API_KEY": { "description": "Optional — enables the AI commands.", "required": false },
    "AI_BASE_URL": { "value": "https://api.openai.com/v1", "required": false },
    "DOWNLOAD_API_URL": { "description": "Optional — enables downloaders.", "required": false }
  },
  "formation": { "web": { "quantity": 1 } },
  "buildpacks": [{ "url": "heroku/nodejs" }]
}
