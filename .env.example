# ─────────────────────────────────────────────
#  DARK EYES BOT — configuration
#  Copy this file to .env and edit. Never commit .env
# ─────────────────────────────────────────────

# ── Identity ─────────────────────────────────
BOT_NAME="Dark Eyes"
BOT_OWNER="Your Name"
# Owner numbers, international format, digits only, comma separated
OWNER_NUMBER="2348012345678"
# Command prefix. Use "." or "!" or "/"
PREFIX="."

# ── Behaviour ────────────────────────────────
# public = everyone, self = owner only (bot ignores everyone else)
BOT_MODE="public"
# Mark incoming messages as read automatically
AUTO_READ="false"
# Show "typing…" while processing commands
AUTO_TYPING="false"
# Max warnings before a member is removed from a group
MAX_WARNS="3"
# Timezone for scheduled jobs
TZ="Africa/Lagos"

# ── Web pairing panel ────────────────────────
PORT="3000"
# If set, the panel asks for this token before pairing. Set this on public servers.
PANEL_TOKEN=""

# ── Storage ──────────────────────────────────
SESSION_DIR="data/auth"
DB_PATH="data/darkeyes.db"

# ── Logging ──────────────────────────────────
LOG_LEVEL="info"
NODE_ENV="development"

# ── AI plugin (optional) ─────────────────────
# Any OpenAI-compatible endpoint works: OpenAI, Groq, OpenRouter, Together…
AI_PROVIDER="openai"
AI_API_KEY=""
AI_BASE_URL="https://api.openai.com/v1"
AI_MODEL="gpt-4o-mini"
AI_SYSTEM_PROMPT="You are Dark Eyes, a witty and helpful WhatsApp assistant. Keep replies short and conversational."
# Auto-reply to every private message with AI (true/false)
AI_AUTO_REPLY="false"

# ── Media downloader plugin (optional) ───────
# Point this at your own resolver API. Expected: GET {url}?url=<link> -> { title, url }
DOWNLOAD_API_URL=""
DOWNLOAD_API_KEY=""
